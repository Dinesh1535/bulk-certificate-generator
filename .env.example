# Application Settings
APP_NAME="Bulk Certificate Generator"
APP_ENV="development"
DEBUG=true

# Database (Default: SQLite, for PostgreSQL use: postgresql+psycopg2://user:pass@localhost:5432/certdb)
DATABASE_URL="sqlite:///./storage/certificates.db"

# Storage
STORAGE_DIR="./storage"

# Server
HOST="0.0.0.0"
PORT=8000
